/*
SPL2 Content
===============
|---------------------|------------------------------------------------------------|
| Template Version    | 0.1.0
| Add-on Name         | Splunk Add-on for Microsoft Windows
| Version Compatible  | 10.1.1
| Splunk-base-URL     | http://docs.splunk.com/Documentation/WindowsAddOn/latest/User/Releasenotes
| Sourcetype          | Perfmon:Process
|---------------------|------------------------------------------------------------|

The template is created by reading props.conf and transforms.conf from an Add-on and converting them into an SPL2 pipeline. Its goal is to extract the same number of fields, with values matching those produced by the original props.conf and transforms.conf.

To execute this template, make sure you have the following:
    - Installed the compatible version of the Add-on in your Splunk Cloud Tenant.
    - Confirm the availability of the lookup dataset
        - Refresh the scpbridge connection by doing the following.
        - Select the Settings icon and then select System connections.
        - On the scpbridge connection, select the Refresh icon.
    - If there are any KVstore lookups, make sure to populate those before using this template.

Note: This template must not be used with Splunk Indexes; it is intended only for exporting to Data-lakes.
*/



/**
 * Performs kv_mode based extractions.
 * Currently only supports json with 1 level of nesting.
 */
function apply_kv_mode($source: dataset):dataset {
    return | from $source
           | eval tmp__raw = replace(_raw, /(?ms)^(\w+)=\s*([\s\S]*?)(?=\R\w+=|\Z)/, "##SEP##\\1##VAL_SEP##\\2##SEP##")
| eval tmp__raw = filter(split(tmp__raw, "##SEP##"), $row -> match($row, /.*##VAL_SEP##.*/ ))
| eval tmp__raw = map(tmp__raw, $row -> split($row, "##VAL_SEP##" ))
| eval tmp__raw = reduce(tmp__raw, json_object(), ($acc, $row)-> if(isnull(json_extract($acc, replace(trim($row[0]), /\s/, "_"))), json_set($acc, replace(trim($row[0]), /\s/, "_"),trim($row[1], "\"\r\n ")), json_set($acc, replace(trim($row[0]), /\s/, "_"), if(isarray(json_extract($acc, replace(trim($row[0]), /\s/,"_"))), json_append(json_extract($acc, replace(trim($row[0]), /\s/,"_")), "",trim($row[1], "\"\r\n ")), json_array(json_extract($acc, replace(trim($row[0]), /\s/,"_")),trim($row[1], "\"\r\n "))))))
| flatten tmp__raw
| fields - tmp__raw

}

/*
Performs regex-based field extractions on the source dataset.

This function emulates the behavior of the following Props & Transforms clauses, in order of execution:
1. TRANSFORMS
2. EXTRACT
3. REPORT
*/
function apply_extractions($source: dataset):dataset {
    return | from $source
           | rex field=_raw /Value=\"?(?P<_value>[^\"\r\n]*[^\"\s])/
           | rex field=_raw /counter=\"?(?P<metric_name>[^\"\r\n]*[^\"\s])/
           | rex field=_raw /object=\"?(?P<object>[^\"\r\n]*[^\"\s])/
           | rex field=_raw /instance=\"?(?P<instance>[^\"\r\n]*[^\"\s])/
           | rex field=_raw /collection=\"?(?P<collection>[^\"\r\n]*[^\"\s])/
}

/*
Renames fields on the source dataset.

This function emulates the behavior of the following Props & Transforms clauses:
1. FIELDALIAS
*/
function apply_normalizations($source: dataset):dataset {
    return | from $source
           | eval dest = host
           | eval src = host
}

/*
Calculates expressions and puts the resulting value into respective fields on the source dataset.

This function emulates the behavior of the following Props & Transforms clauses:
1. EVAL
*/
function apply_calculations_on_fields($source: dataset):dataset {
    return | from $source
           | eval process_name = if(instance!="_Total" AND instance!="Idle",instance,null)
           | eval process_cpu_used_percent = if(instance!="_Total" AND instance!="Idle" AND counter=="% Processor Time", Value, null)
           | eval process_mem_used = if(instance!="_Total" AND instance!="Idle" AND counter=="Working Set - Private", Value, null)
           | eval metric_type = "gauge"
           | eval mem_used = if(instance!="_Total" AND instance!="Idle" AND counter=="Working Set - Private", Value, null)
           | eval vendor_product = "Microsoft Windows"
}



/*
Enriches your source dataset with related information that is in a lookup dataset.

This function emulates the behavior of the following Props & Transforms clauses:
1. LOOKUP
*/
function apply_lookups($source: dataset):dataset {
    return | from $source


}







@annotation
function field_extractions_predicates($predicate: any);
export field_extractions_predicates

@field_extractions_predicates(predicate:
[{"field": "sourcetype", "operator": "EQUAL", "values": ["Perfmon:Process"]}])
function Perfmon_Process_field_extractions_function($source: dataset):dataset {
    return | from $source

           | apply_kv_mode
           | apply_extractions
           | apply_normalizations
           | apply_calculations_on_fields
           | apply_lookups

}
export Perfmon_Process_field_extractions_function
