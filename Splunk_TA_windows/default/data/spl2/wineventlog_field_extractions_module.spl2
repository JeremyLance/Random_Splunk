           | lookup windows_signature_lookup2 signature_id, Status OUTPUTNEW signature AS reason
           | lookup windows_endpoint_port_transport_lookup Protocol OUTPUTNEW transport
           | lookup windows_wineventlog_change_object_fields_lookup EventCode OUTPUTNEW change_type, object_attrs, object_category, result

           // default_lookup_extractions


           // scripted_lookups

}







