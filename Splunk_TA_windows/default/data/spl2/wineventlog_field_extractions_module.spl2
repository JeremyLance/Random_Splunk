/*
SPL2 Content
===============
|---------------------|------------------------------------------------------------|
| Template Version    | 0.1.0
| Add-on Name         | Splunk Add-on for Microsoft Windows
| Version Compatible  | 10.1.1
| Splunk-base-URL     | http://docs.splunk.com/Documentation/WindowsAddOn/latest/User/Releasenotes
| Sourcetype          | WinEventLog
|---------------------|------------------------------------------------------------|

The template is created by reading props.conf and transforms.conf from an Add-on and converting them into an SPL2 module. Its goal is to extract the same number of fields, with values matching those produced by the original props.conf and transforms.conf.

To execute this template, make sure you have the following:
    - Installed the compatible version of the Add-on in your Splunk Cloud Tenant.
    - Confirm the availability of the lookup dataset
        - Refresh the scpbridge connection by doing the following.
        - Select the Settings icon and then select System connections.
        - On the scpbridge connection, select the Refresh icon.
    - If there are any KVstore lookups, make sure to populate those before using this template.

Note: This template must not be used with Splunk Indexes; it is intended only for exporting to Data-lakes.
*/
import windows_update_status_lookup from ~/../../lookups
import windows_start_mode_lookup from ~/../../lookups
import xmlsecurity_eventcode_errorcode_action_lookup from ~/../../lookups
import windows_defender_severity_lookup from ~/../../lookups
import windows_signature_lookup from ~/../../lookups
import windows_severity_lookup from ~/../../lookups
import windows_signature_lookup2 from ~/../../lookups
import windows_reason_lookup from ~/../../lookups
import windows_wineventlog_change_action_lookup from ~/../../lookups
import windows_audit_changes_lookup from ~/../../lookups
import windows_action_lookup from ~/../../lookups
import windows_privilege_lookup from ~/../../lookups
import windows_app_lookup from ~/../../lookups
import MSADGroupType from ~/../../lookups
import windows_endpoint_service_service_name_lookup from ~/../../lookups
import windows_endpoint_service_service_type_lookup from ~/../../lookups
import windows_endpoint_port_transport_lookup from ~/../../lookups
import windows_wineventlog_change_object_fields_lookup from ~/../../lookups


function WinEventLog_prep($source: dataset):dataset {
    return | from $source
           // auto kv mode

           | eval tmp__raw = replace(_raw, /(?ms)^(\w+)=\s*([\s\S]*?)(?=\R\w+=|\Z)/, "##SEP##\\1##VAL_SEP##\\2##SEP##")
| eval tmp__raw = filter(split(tmp__raw, "##SEP##"), $row -> match($row, /.*##VAL_SEP##.*/ ))
| eval tmp__raw = map(tmp__raw, $row -> split($row, "##VAL_SEP##" ))
| eval tmp__raw = reduce(tmp__raw, json_object(), ($acc, $row)-> if(isnull(json_extract($acc, replace(trim($row[0]), /\s/, "_"))), json_set($acc, replace(trim($row[0]), /\s/, "_"),trim($row[1], "\"\r\n ")), json_set($acc, replace(trim($row[0]), /\s/, "_"), if(isarray(json_extract($acc, replace(trim($row[0]), /\s/,"_"))), json_append(json_extract($acc, replace(trim($row[0]), /\s/,"_")), "",trim($row[1], "\"\r\n ")), json_array(json_extract($acc, replace(trim($row[0]), /\s/,"_")),trim($row[1], "\"\r\n "))))))
| flatten tmp__raw
| fields - tmp__raw


           // regex based extractions

           | rex field=Image_File_Name /^(?P<file_path>.*[\\\/]+)*(?P<file_name>.*)$/
           | rex field=_raw /(?sm)\nMessage=(?<Message>.+)$/
           | eval tmp_raw_User = User
| eval tmp_raw_Type = Type
| eval tmp_Message = replace(Message, /\n([^=\n\r\s]+)\s+\=\s+([^\n]*)/, "##SEP##\\1##VAL_SEP##\\2##SEP##")
| eval tmp_Message = filter(split(tmp_Message, "##SEP##"), $row -> match($row, /.*##VAL_SEP##.*/ ))
| eval tmp_Message = map(tmp_Message, $row -> split($row, "##VAL_SEP##" ))
| eval tmp_Message = map(tmp_Message, $row -> json_array(replace(replace(trim($row[0]), /[^\w]/, "_"), /^_+/, ""), trim($row[1], "\r\n\t ")))
| eval tmp_Message = filter(tmp_Message, $row -> $row[1] != "")
| eval tmp_Message = reduce(tmp_Message, json_object(), ($acc, $row)-> if(isnull(json_extract($acc, $row[0])), json_set($acc, $row[0], $row[1]), json_set($acc, $row[0], if(isarray(json_extract($acc, $row[0])), json_append(json_extract($acc, $row[0]), "", $row[1]), json_array(json_extract($acc, $row[0]), $row[1])))))
| eval tmp_Message_User = json_extract(tmp_Message, "User")
| eval tmp_Message_Type = json_extract(tmp_Message, "Type")
| flatten tmp_Message
| eval User = if(isnotnull(tmp_raw_User) AND isnotnull(tmp_Message_User), if(isarray(tmp_Message_User), reduce(tmp_Message_User, json_array(tmp_raw_User), ($acc, $row)->json_append($acc, "", $row)), json_array(tmp_raw_User, tmp_Message_User)), User)
| eval Type = if(isnotnull(tmp_raw_Type) AND isnotnull(tmp_Message_Type), if(isarray(tmp_Message_Type), reduce(tmp_Message_Type, json_array(tmp_raw_Type), ($acc, $row)->json_append($acc, "", $row)), json_array(tmp_raw_Type, tmp_Message_Type)), Type)
| fields - tmp_Message, tmp_raw_User, tmp_raw_Type, tmp_Message_User, tmp_Message_Type

           | eval tmp_raw_User = User
| eval tmp_raw_Type = Type
| eval tmp_Message = replace(Message, /\n([^:\n\r]+):[ \t]++([^\n]*)/, "##SEP##\\1##VAL_SEP##\\2##SEP##")
| eval tmp_Message = filter(split(tmp_Message, "##SEP##"), $row -> match($row, /.*##VAL_SEP##.*/ ))
| eval tmp_Message = map(tmp_Message, $row -> split($row, "##VAL_SEP##" ))
| eval tmp_Message = map(tmp_Message, $row -> json_array(replace(replace(trim($row[0]), /[^\w]/, "_"), /^_+/, ""), trim($row[1], "\r\n\t ")))
| eval tmp_Message = filter(tmp_Message, $row -> $row[1] != "")
| eval tmp_Message = reduce(tmp_Message, json_object(), ($acc, $row)-> if(isnull(json_extract($acc, $row[0])), json_set($acc, $row[0], $row[1]), json_set($acc, $row[0], if(isarray(json_extract($acc, $row[0])), json_append(json_extract($acc, $row[0]), "", $row[1]), json_array(json_extract($acc, $row[0]), $row[1])))))
| eval tmp_Message_User = json_extract(tmp_Message, "User")
| eval tmp_Message_Type = json_extract(tmp_Message, "Type")
| flatten tmp_Message
| eval User = if(isnotnull(tmp_raw_User) AND isnotnull(tmp_Message_User), if(isarray(tmp_Message_User), reduce(tmp_Message_User, json_array(tmp_raw_User), ($acc, $row)->json_append($acc, "", $row)), json_array(tmp_raw_User, tmp_Message_User)), User)
| eval Type = if(isnotnull(tmp_raw_Type) AND isnotnull(tmp_Message_Type), if(isarray(tmp_Message_Type), reduce(tmp_Message_Type, json_array(tmp_raw_Type), ($acc, $row)->json_append($acc, "", $row)), json_array(tmp_raw_Type, tmp_Message_Type)), Type)
| fields - tmp_Message, tmp_raw_User, tmp_raw_Type, tmp_Message_User, tmp_Message_Type


           // field alias based extractions

           | eval category = TaskCategory
           | eval dvc_nt_host = host
           | eval dvc = ComputerName
           | eval event_id = RecordNumber
           | eval severity_id = EventType
           | eval id = RecordNumber
           | eval user_group_id = Primary_Group_ID
           | eval service_id = Service_ID
           | eval service = Service_Name
           | eval service_name = Service_Name
           | eval process = Process
           | eval parent_process = Creator_Process_Name
           | eval user_id = User_ID

           // eval based extractions

           | eval signature_id = if(SourceName="Microsoft-Windows-WindowsUpdateClient",signature_id,EventCode)
           | eval process_name = if(EventCode==4688, New_Process_Name, if(Process_Name!="" AND Process_Name!="-", Process_Name, null))
           | eval vendor_product = "Microsoft Windows"

}
function WinEventLog_Microsoft_Windows_PrintService_Operational($source: dataset):dataset {
    return | from $source
           // auto kv mode


           // regex based extractions

           | rex field=_raw /LogName=(?<app>\S+)\/[\s\S]*?User=(?<user>\S+)[\s\S]*?Message=(?<message>.*?)$/
           | rex field=_raw /Document\s+(?P<print_job_ID>\d+),/
           | rex field=_raw /Pages printed:\s+(?P<pages_printed>\d+)/
           | rex field=_raw /owned by\s+(?<owner>\S+)/
           | rex field=_raw /Document(?:\s+\d+)?\s*,\s+(?P<object>"[^"]+\.\w{2,4}"|\S+\.\w{2,4})/
           | rex field=_raw /owned by \S+ on (?:\\\\)?(?<src>\S+)/
           | rex field=_raw /was\s+printed\s+on\s+(?:Printer\s+)?(?<dest_name>[^()]+?)(?:\s+\([^)]+\))?(?=\s+(?:through|via)\s+port|\. )/
           | rex field=_raw /(?:through|via)\s+port\s+(?:IP_)?(?<dest>(?:\d{1,3}\.){3}\d{1,3}|[0-9A-Fa-f:%]*:(?:\d{1,3}\.){3}\d{1,3}|[0-9A-Fa-f:%]*:[0-9A-Fa-f:%]+|[^\s.]+)(?=[\s.)]|$)/
           | rex field=_raw /Size\s+in\s+bytes:\s+(?<bytes>\d+)/

           // field alias based extractions


           // eval based extractions

           | eval vendor_product = "Microsoft-Windows-PrintService"
           | eval object = replace(object, "^\"|\"$", "")
           | eval object_attrs = mvjoin(mvappend( if(isnotnull(pages_printed), "pages printed=" + pages_printed, null), if(isnotnull(print_job_ID), "print job ID=" + print_job_ID, null) ), ", ")
           // Workaround to remove null values from mv fields and display only a single value if length of mv field is one
           | eval object_attrs = if(ismv(object_attrs), json_array_to_mv(filter(mv_to_json_array(object_attrs), $row-> isnotnull($row))), object_attrs)
           | eval object_attrs = if(ismv(object_attrs) and mvcount(object_attrs) == 1, mvindex(object_attrs, 0), object_attrs)
           | eval object_category = case(EventCode == 307, "Document", EventCode IN (800, 801, 805), "Diagnostic", EventCode == 842, "Driver", true, null)
           | eval action = case(EventCode == 307, "shared", true, null)
           | eval object_size = round(bytes / 1024, 2)
           | eval dest_type = "printer"

}
function WinEventLog_System($source: dataset):dataset {
    return | from $source
           // auto kv mode


           // regex based extractions

           | eval source = coalesce(source, if(match(_raw, /SourceName\=IAS/), "WinEventLog:System:IAS", null))
           | rex field=ComputerName /(?:[\\]+)?(?P<dest>[^-].*)/
           | rex field=_raw /Installation Ready: The following updates are downloaded and ready for installation.*?:\s*(?P<signature_message>(?:.*[\r\n])*.*)/
           | rex field=signature_message /-\s+(?P<signature>[^\r\n]+)/
           | rex field=_raw /Windows successfully installed the following update:\s+(?P<signature>.*)/
           | rex field=Message /(?P<signature>(?:The\s+time\s+provider\s+\w+\s+is\s+configured\s+to\s+acquire\s+time\s+from\s+one\s+or\s+more\s+time\s+sources\,\s+however\s+none\s+of\s+the\s+sources\s+are\s+currently\s+accessible)|(?:The\s+time\s+service\s+is\s+now\s+synchronizing\s+the\s+system\s+time\s+with\s+the\s+time\s+source)|(?:Time\s+Provider\s+\w+\:\s+An\s+error\s+occurred\s+during\s+DNS\s+lookup\s+of\s+the\s+manually\s+configured\s+peer))/
           | rex field=signature /(?P<signature_id>KB\d+)/
           | rex field=User /(?:[^\\]+\\)?(?P<user>.+)/
           | rex field=_raw /Message\=User\s+(?:[^\/\\]+[\/\\])?(?P<user>[^.]+).*?was/
           | rex field=Message /^The (?P<Service_Name>.*) service entered the (?P<status>.*) state\./
           | rex field=Message /^The start type of the (?P<Service_Name>.*) service was changed from .* to (?P<start_type2>.*)\./
           | rex field=UserData_Xml /(?ms)<updatelist(?:\s+[^>]+)?>(?P<signature_message>.*?)<\/updatelist>/
           | rex field=UserData_Xml /(?ms)<updatetitle(?:\s+[^>]+)?>(?P<signature>.*?)<\/updatetitle>/
           | rex field=_raw /<Computer>(?P<dest>[^<]+)<\/Computer>/
           | eval tmp_raw_User = User
| eval tmp_raw_Type = Type
| eval tmp_Message = replace(Message, /\n([^=\n\r\s]+)\s+\=\s+([^\n]*)/, "##SEP##\\1##VAL_SEP##\\2##SEP##")
| eval tmp_Message = filter(split(tmp_Message, "##SEP##"), $row -> match($row, /.*##VAL_SEP##.*/ ))
| eval tmp_Message = map(tmp_Message, $row -> split($row, "##VAL_SEP##" ))
| eval tmp_Message = map(tmp_Message, $row -> json_array(replace(replace(trim($row[0]), /[^\w]/, "_"), /^_+/, ""), trim($row[1], "\r\n\t ")))
| eval tmp_Message = filter(tmp_Message, $row -> $row[1] != "")
| eval tmp_Message = reduce(tmp_Message, json_object(), ($acc, $row)-> if(isnull(json_extract($acc, $row[0])), json_set($acc, $row[0], $row[1]), json_set($acc, $row[0], if(isarray(json_extract($acc, $row[0])), json_append(json_extract($acc, $row[0]), "", $row[1]), json_array(json_extract($acc, $row[0]), $row[1])))))
| eval tmp_Message_User = json_extract(tmp_Message, "User")
| eval tmp_Message_Type = json_extract(tmp_Message, "Type")
| flatten tmp_Message
| eval User = if(isnotnull(tmp_raw_User) AND isnotnull(tmp_Message_User), if(isarray(tmp_Message_User), reduce(tmp_Message_User, json_array(tmp_raw_User), ($acc, $row)->json_append($acc, "", $row)), json_array(tmp_raw_User, tmp_Message_User)), User)
| eval Type = if(isnotnull(tmp_raw_Type) AND isnotnull(tmp_Message_Type), if(isarray(tmp_Message_Type), reduce(tmp_Message_Type, json_array(tmp_raw_Type), ($acc, $row)->json_append($acc, "", $row)), json_array(tmp_raw_Type, tmp_Message_Type)), Type)
| fields - tmp_Message, tmp_raw_User, tmp_raw_Type, tmp_Message_User, tmp_Message_Type

           | rex field=_raw /(?ms)EventCode=104(?:\n|\r).*(?:Message=The\s(?<object>.+)\sfile)/

           // field alias based extractions

           | eval body = signature_message
           | eval body = Message
           | eval package = signature_id
           | eval package_title = signature
           | eval signature = coalesce(signature, updateTitle)

           // eval based extractions

           | eval file_name = case(EventCode IN (17, 18), signature_message, EventCode == 19, signature, true, null)
           | eval service_path = case(EventCode==7045,Service_File_Name)
           | eval status = case(EventCode=="7036" AND status=="running","started",EventCode=="7036" AND status=="stopped","stopped",EventCode=="104","success",EventCode==7045,"installed")
           | eval vendor = "Microsoft"
           | eval product = "Windows"
           | eval Error_Code = case(isnotnull(Status), Status, isnotnull(Error_Code), Error_Code, true, "-")
           | eval user = case(EventCode==7040,case(user!="-",user),EventCode==7045,case(user!="-",if(user="NOT_TRANSLATED",Sid,user)),true,user)
           | eval user_name = if(EventCode==104, User, user_name)
           | eval result = if(EventCode==104, "log file was cleared", result)
           | eval object_category = if(EventCode==104, "audit log", object_category)
           | eval action = if(EventCode==104, "cleared", action)
           | eval change_type = case(EventCode==104, "audit", true, change_type)
           | eval app = if(SourceName="IAS","ias",null)

}
function WinEventLog_Microsoft_Windows_Windows_Defender_Operational($source: dataset):dataset {
    return | from $source
           // auto kv mode


           // regex based extractions

           | rex field=Path /^(?P<file_path>(?:.*[\\\/]+)*(?P<file_name>[^-].*))$/
           | rex field=Message /For more information please see the following:\s*(?P<url>https?:\/\/[^\s]+)\s*Name:/
           | rex field=_raw /User=(?P<user>[^\r\n]+)/
           | rex field=_raw /^(?<date>\d{2}\/\d{2}\/\d{4}\s+\d{2}:\d{2}:\d{2}(?:\.\d{3})?\s+(?:AM|PM))/

           // field alias based extractions

           | eval vendor_severity = Severity

           // eval based extractions

           | eval signature = Name
           | eval dest = coalesce('ComputerName','Computer')
           | eval category = coalesce(Category, category)
           | eval vendor_product = case(SourceName="Microsoft-Windows-Windows Defender", "Microsoft Defender Antivirus", true, SourceName)
           | eval signature_id = EventCode
           | eval action = case( lower(Action) == "quarantine", "blocked", lower(Action) == "not applicable", "deferred", true, action)

}
function WinEventLog_Microsoft_Windows_PowerShell_Operational($source: dataset):dataset {
    return | from $source
           // auto kv mode


           // regex based extractions

           | rex field=ComputerName /(?:[\\]+)?(?P<dest>[^-].*)/

           // field alias based extractions


           // eval based extractions

           | eval signature = case(EventCode==4103,"Microsoft-Windows-PowerShell Executing Pipeline",EventCode==4104,"Microsoft-Windows-PowerShell Execute a Remote Command")

}
function WinEventLog_Application($source: dataset):dataset {
    return | from $source
           // auto kv mode


           // regex based extractions


           // field alias based extractions


           // eval based extractions

           | eval dest = coalesce('ComputerName','Computer')
           | eval Error_Code = case(isnotnull(Status), Status, isnotnull(Error_Code), Error_Code, true, "-")

}
function WinEventLog_Security($source: dataset):dataset {
    return | from $source
           // auto kv mode


           // regex based extractions

           | rex field=Message /(?ms)^\s*(?:Privileges|Assigned):\s+(?P<vendor_privilege>.*)/
           | rex field=Message /(?ms)^\s*(?:Privileges|Assigned):?\s+(?P<vendor_privilege>.*?)(?:^[^:]+:)/
           | rex field=vendor_privilege /^(?P<privilege_id>[^\r\n]+)/
           | rex field=Token_Elevation_Type /^[^\d]+(?P<Token_Elevation_Type_id>\d+)/
           | rex field=Caller_Logon_ID /(?P<session_id>.+)/
           | rex field=Client_Logon_ID /(?P<session_id>.+)/
           | rex field=Logon_ID /(?:(?:[^\n]+)\n)?(?P<session_id>.*)/
           | rex field=ComputerName /(?:[\\]+)?(?P<dest>[^-].*)/
           | rex field=Target_Server_Name /(?:[\\]+)?(?P<dest>[^-].*)/
           | rex field=Target_Account_ID /(?P<dest_nt_domain>.+)[\\]/
           | rex field=Supplied_Realm_Name /(?P<dest_nt_domain>.+)/
           | rex field=Security_ID /(?P<dest_nt_domain>.+)[\\]/
           | rex field=User_ID /(?P<dest_nt_domain>.+)[\\]/
           | rex field=Domain /(?:(?:[^\n]+)\n)?(?P<dest_nt_domain>.+)/
           | rex field=New_Domain /(?:(?:[^\n]+)\n)?(?P<dest_nt_domain>.+)/
           | rex field=Account_Domain /(?:(?:[^\n]+)\n)?(?P<dest_nt_domain>.+)/
           | rex field=Group_Domain /(?:(?:[^\n]+)\n)?(?P<dest_nt_domain>.+)/
           | rex field=Primary_Domain /(?:(?:[^\n]+)\n)?(?P<dest_nt_domain>.+)/
           | rex field=Target_Domain /(?:(?:[^\n]+)\n)?(?P<dest_nt_domain>.+)/
           | rex field=ComputerName /(?:[\\]+)?(?P<dest_nt_host>[^-].*)/
           | rex field=Target_Server_Name /(?:[\\]+)?(?P<dest_nt_host>[^-].*)/
           | rex field=Client_Address /(?:[\\]+)?(?P<src>[^-].*)/
           | rex field=Source_Network_Address /(?:[\\]+)?(?P<src>[^-].*)/
           | rex field=Client_Machine_Name /(?:[\\]+)?(?P<src>[^-].*)/
           | rex field=Caller_Machine_Name /(?:[\\]+)?(?P<src>[^-].*)/
           | rex field=Workstation_Name /(?:[\\]+)?(?P<src>[^-].*)/
           | rex field=Source_Workstation /(?:[\\]+)?(?P<src>[^-].*)/
           | rex field=_raw /(?ms)(?:Subject)\s*:.*?Security\sID:[ \t]*(?P<src_subject_security_id>.*?)[\\|\n]/
           | rex field=Client_Address /(?:[\\]+)?(?P<src_ip>[^-].*)/
           | rex field=Source_Network_Address /(?:[\\]+)?(?P<src_ip>[^-].*)/
           | rex field=Security_ID /(?!^-$)(?P<src_nt_domain>.+)[\\]/
           | rex field=_raw /(?ms)(?:Subject|User|Account\sInformation)\s*:.*?Security\sID:[ \t]*(?P<src_nt_domain>.*?)[\\|\n]/
           | rex field=Account_Domain /(?!^-$)(?P<src_nt_domain>[^\n]+)\n/
           | rex field=Client_Domain /(?!^-$)(?P<src_nt_domain>.+)/
           | rex field=Caller_Domain /(?!^-$)(?P<src_nt_domain>.+)/
           | rex field=Caller_Computer_Name /(?:[\\]+)?(?P<src_nt_host>[^-].*)/
           | rex field=Client_Machine_Name /(?:[\\]+)?(?P<src_nt_host>[^-].*)/
           | rex field=Caller_Machine_Name /(?:[\\]+)?(?P<src_nt_host>[^-].*)/
           | rex field=Workstation_Name /(?:[\\]+)?(?P<src_nt_host>[^-].*)/
           | rex field=Source_Workstation /(?:[\\]+)?(?P<src_nt_host>[^-].*)/
           | rex field=User_Name /(?!^-$)(?P<src_user>.+)/
           | rex field=Account_Name /(?!^-$)(?P<src_user>[^\n]+)\n/
           | rex field=Client_User_Name /(?!^-$)(?P<src_user>.+)/
           | rex field=Caller_User_Name /(?!^-$)(?P<src_user>.+)/
           | rex field=Security_ID /(?:[^\\]+\\)?(?P<user>.+)/
           | rex field=User /(?:[^\\]+\\)?(?P<user>.+)/
           | rex field=User_Name /(?P<user>.+)/
           | rex field=Account_Name /(?:(?:[^\n]*)\n)?(?P<user>[^\n]*)/
           | rex field=Account_Name /(?:(?:[^\n]*)\n)?(?:(?:CN|cn)=)?(?P<user>[^\n]*?),.*/
           | rex field=New_Account_Name /(?P<user>.+)/
           | rex field=Target_Account_Name /(?P<user>.+)/
           | rex field=Primary_User_Name /(?P<user>.+)/
           | rex field=Target_User_Name /(?P<user>.+)/
           | rex field=Logon_account /(?:[^\\]+\\)?(?P<user>.+)/
           | rex field=Logon_Account /(?:[^\\]+\\)?(?P<user>.+)/
           | rex field=Security_ID /(?P<member_id>.+)/
           | rex field=Member_ID /(?:[^\\]+\\)?(?P<member_id>.+)/
           | rex field=Account_Name /(?P<member_dn>.+)/
           | rex field=Member_Name /(?P<member_dn>.+)/
           | rex field=Security_ID /(?P<member_nt_domain>[^\\]+\\)?(?:.+)/
           | rex field=Member_ID /(?P<member_nt_domain>[^\\]+\\)?(?:.+)/
           | rex field=Group_Type_Change /Security (?P<MSADGroupClassID>Enabled|Disabled) (?P<MSADGroupType>\w+) Group (?P<msad_action>Changed) to Security (?P<MSADNewGroupClassID>Enabled|Disabled) (?P<MSADNewGroupType>\w+) Group[:\.]/
           | rex field=Change_Type /Security[ -](?P<MSADGroupClassID>[Ee]nabled|[Dd]isabled) (?P<MSADGroupType>\w+) Group Changed to Security[ -](?P<MSADNewGroupClassID>[Ee]nabled|[Dd]isabled) (?P<MSADNewGroupType>\w+) Group[.:]/
           | rex field=Description /Security (?P<MSADGroupClassID>Enabled|Disabled) (?P<MSADGroupType>\w+) Group (?P<msad_action>.*?)[:\.]/
           | rex field=_raw /(?ms)EventCode=(?P<msad_action>4781|4912)\s*\n.*Message=(?:.*?)[:\.]/
           | rex field=_raw /(?ms).*An attempt was made to (?P<msad_action>.*?)[:\.]/
           | rex field=_raw /(?ms).*A user account was (?P<msad_action>.*?)[:\.]/
           | rex field=_raw /(?ms).*A computer account was (?P<msad_action>.*?)[:\.]/
           | rex field=Description /User Account (?P<msad_action>.*?)[:\.]/
           | rex field=Description /Computer Account (?P<msad_action>.*?)[:\.]/
           | rex field=_raw /(?ms).*Policy Change Details:\s*\n(?P<MSADChangedAttributes>.*)/
           | rex field=_raw /(?ms).*Category Settings:\s*\n(?P<MSADChangedAttributes>.*)/
           | rex field=_raw /(?ms)EventCode=(?:624|645|4720|4741).*Attributes:\s*\n(?P<MSADChangedAttributes>.*)/
