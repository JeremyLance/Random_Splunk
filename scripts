############################################################
# Core security and system logs
############################################################
# auditd security events - process, auth, file, network, daemon events
[monitor:///var/log/audit/audit.log]
disabled = 0
index = sec_os_uhgid-000024
sourcetype = linux_audit
ignoreOlderThan = 30d

# Debian/Ubuntu authentication, SSH, PAM, sudo, su
[monitor:///var/log/auth.log]
disabled = 0
index = sec_os_uhgid-000024
sourcetype = syslog
ignoreOlderThan = 30d

# RHEL/CentOS authentication, SSH, PAM, sudo, su
[monitor:///var/log/secure]
disabled = 0
index = sec_os_uhgid-000024
sourcetype = syslog
ignoreOlderThan = 30d

# dedicated sudo command log if configured
[monitor:///var/log/sudo.log]
disabled = 0
index = sec_os_uhgid-000024
sourcetype = syslog
ignoreOlderThan = 30d

# cron job execution and failures
