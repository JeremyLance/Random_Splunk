
############################################################
# Strip internal fallback suffixes (-too_small, -2, -6, etc)
############################################################
[remove_sourcetype_suffix]
REGEX = ^(.+?)(?:-(?:too_small|\d+))$
FORMAT = sourcetype::$1
DEST_KEY = MetaData:Sourcetype

[identity]
REGEX = .
DEST_KEY = queue
FORMAT = indexQueue

########################################
# REMOVE NUMERIC SUFFIXES
########################################
[strip_numeric_suffix]
REGEX = ^(.*)-\d+$
FORMAT = sourcetype::$1
DEST_KEY = MetaData:Sourcetype

########################################
# REMOVE -too_small
########################################
[strip_toosmall_suffix]
REGEX = ^(.*)-too_small$
FORMAT = sourcetype::$1
DEST_KEY = MetaData:Sourcetype

########################################
# FORCE DEFINITIONS
########################################
[force_dnf]
REGEX = .
FORMAT = sourcetype::dnf
DEST_KEY = MetaData:Sourcetype

[force_cloudwatch]
REGEX = .
FORMAT = sourcetype::aws_cloudwatch_agent
DEST_KEY = MetaData:Sourcetype

[force_cloud_init]
REGEX = .
FORMAT = sourcetype::cloud_init
DEST_KEY = MetaData:Sourcetype

[force_cloud_init_output]
REGEX = .
FORMAT = sourcetype::cloud_init_output
DEST_KEY = MetaData:Sourcetype

[force_jstack]
REGEX = .
FORMAT = sourcetype::jstack
DEST_KEY = MetaData:Sourcetype

[force_instance_state]
REGEX = .
FORMAT = sourcetype::emr_instance_state
DEST_KEY = MetaData:Sourcetype

[force_traps]
REGEX = .
FORMAT = sourcetype::trapsd
DEST_KEY = MetaData:Sourcetype

